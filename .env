# general
DATADIR=/home/will/docker_data
TZ=Australia/Adelaide
PUID=1000
PGID=1000

# networking
# run: tailscale ip -4
TAILSCALE_IP=your-tailscale-ip
LOCAL_IP=192.168.1.x
LOKI_URL=http://${LOCAL_IP}:3100/loki/api/v1/push

# watchtower
WATCHTOWER_EMAIL_TO=your@email.com

# influxdb
INFLUXDB_TOKEN=put_key_here
INFLUXDB_ORG=default
INFLUXDB_BUCKET=default

# telegraf
OPENWEATHERMAP_API_KEY=put_key_here
MQTT_USER=user
MQTT_PASSWORD=put_key_here

# n8n
# pre-generate these — shell substitution does NOT work in .env files:
#   openssl rand -hex 32      → N8N_ENCRYPTION_KEY
#   openssl rand -base64 32   → N8N_DB_PASSWORD
N8N_HOST=n8n.lab
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.lab
N8N_ENCRYPTION_KEY=put_generated_key_here
N8N_DB_PASSWORD=put_generated_password_here

# ollama
OLLAMA_API_URL=http://192.168.1.x:11434
OLLAMA_MODEL=mistral

# time machine / samba
TM_USERNAME=tm_username
TM_PASSWORD=tm_password
SMB_NAME=smb_name
SMB_LOGIN=smb_username
SMB_PASSWORD=smb_password

# plex
# generate fresh at plex.tv/claim (token expires in 4 min) — only needed on first run
# set in .env.local, not here
PLEX_CLAIM=

# qbittorrent (set after first run)
QBIT_USERNAME=put_username_here
QBIT_PASSWORD=put_password_here

# *arr API keys (fill in after each app's first run: Settings > General > API Key)
RADARR_API_KEY=put_key_here
SONARR_API_KEY=put_key_here
LIDARR_API_KEY=put_key_here
LAZYLIBRARIAN_API_KEY=put_key_here

# notifiarr
NOTIFIARR_API_KEY=put_key_here

# powerwall
POWERWALL_PASSWORD=powerwall_password
